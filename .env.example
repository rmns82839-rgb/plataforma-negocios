# Proyecto Supabase NUEVO de la plataforma (no el de Matriz). Settings → API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Google Maps (opcional). Sin estas claves la plataforma sigue con OpenStreetMap + OpenRouteService.
# Clave de NAVEGADOR (restringida por dominio en Google Cloud) para dibujar el mapa:
VITE_GOOGLE_MAPS_KEY=
# En Vercel (NO con prefijo VITE_): GOOGLE_MAPS_SERVER_KEY=clave-de-servidor  y  MAPA_PROVEEDOR=google
